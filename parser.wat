;; csv-reader-speed v2: WASM SIMD byte-through CSV reader.
;; Consumes cases.json bytes, emits answers.json bytes directly (no JSON.parse / JSON.stringify).
;; Semantics replicate csv-reader 1.0.0 exactly (see RULES.txt): BOM, CRLF, lone-CR stray,
;; quoted fields with "" escapes, CR/LF->LF inside quotes, quote junk, unterminated quote
;; re-read as unquoted, short/long rows, blank-line and stray-CR-only-line rules.
;; Memory map (128 MiB, 2048 pages):
;;   0x00000000 input (cases.json, up to 32 MiB)  0x02000000 text scratch (unescaped CSV)
;;   0x02200000 xform (materialised fields)  0x02800000 rows JSON  0x02E00000 errors JSON
;;   0x03000000 cols JSON  0x03010000 field descriptors  0x03020000 key buf  0x03030000 uint buf
;;   0x04000000 output (answers.json)   0x07F00000 literals
(module
  (memory (export "memory") 2048 2048)

  ;; ---- literals, 32 bytes apart ----
  (global $L_COLUMNS i32 (i32.const 133169152))
  (global $L_ROWS i32 (i32.const 133169184))
  (global $L_ERRORS i32 (i32.const 133169216))
  (global $L_CLOSE i32 (i32.const 133169248))
  (global $L_CODE i32 (i32.const 133169280))
  (global $L_LINE i32 (i32.const 133169312))
  (global $L_ROW i32 (i32.const 133169344))
  (global $L_FIELDS i32 (i32.const 133169376))
  (global $L_EXTRA i32 (i32.const 133169408))
  (global $L_RBRACE i32 (i32.const 133169440))
  (global $L_LBRACK i32 (i32.const 133169472))
  (global $L_RBRACK i32 (i32.const 133169504))
  (global $L_COMMA i32 (i32.const 133169536))
  (global $L_QUOTE i32 (i32.const 133169568))
  (global $L_NULL i32 (i32.const 133169600))
  (global $L_STRAY i32 (i32.const 133169632))
  (global $L_JUNK i32 (i32.const 133169664))
  (global $L_UNTERM i32 (i32.const 133169696))
  (global $L_SHORT i32 (i32.const 133169728))
  (global $L_LONG i32 (i32.const 133169760))
  (global $L_EMPTY i32 (i32.const 133169792))
  (global $L_HEX i32 (i32.const 133169824))
  (global $L_ID i32 (i32.const 133169856))
  (global $L_INPUT i32 (i32.const 133169888))
  (global $L_TEXT i32 (i32.const 133169920))
  (global $L_HEADER i32 (i32.const 133169952))

  (data (i32.const 133169152) "{\"columns\":")
  (data (i32.const 133169184) ",\"rows\":[")
  (data (i32.const 133169216) "],\"errors\":[")
  (data (i32.const 133169248) "]}")
  (data (i32.const 133169280) "{\"code\":\"")
  (data (i32.const 133169312) "\",\"line\":")
  (data (i32.const 133169344) ",\"row\":")
  (data (i32.const 133169376) ",\"fields\":")
  (data (i32.const 133169408) ",\"extra\":")
  (data (i32.const 133169440) "}")
  (data (i32.const 133169472) "[")
  (data (i32.const 133169504) "]")
  (data (i32.const 133169536) ",")
  (data (i32.const 133169568) "\"")
  (data (i32.const 133169600) "null")
  (data (i32.const 133169632) "stray_cr")
  (data (i32.const 133169664) "quote_junk")
  (data (i32.const 133169696) "unterminated_quote")
  (data (i32.const 133169728) "short_row")
  (data (i32.const 133169760) "long_row")
  (data (i32.const 133169792) "[]")
  (data (i32.const 133169824) "0123456789abcdef")
  (data (i32.const 133169856) "id")
  (data (i32.const 133169888) "input")
  (data (i32.const 133169920) "text")
  (data (i32.const 133169952) "header")

  ;; ---- region bases ----
  (global $TEXT_BASE i32 (i32.const 33554432))
  (global $XFORM_BASE i32 (i32.const 35651584))
  (global $ROWS_BASE i32 (i32.const 41943040))
  (global $ERRS_BASE i32 (i32.const 48234496))
  (global $COLS_BASE i32 (i32.const 50331648))
  (global $FIELDS_BASE i32 (i32.const 50397184))
  (global $KEY_BUF i32 (i32.const 50462720))
  (global $UINT_BUF i32 (i32.const 50528256))
  (global $OUT_BASE i32 (i32.const 67108864))

  ;; ---- mutable state ----
  (global $in_pos (mut i32) (i32.const 0))
  (global $in_len (mut i32) (i32.const 0))
  (global $text_len (mut i32) (i32.const 0))
  (global $t_end (mut i32) (i32.const 0))
  (global $pos (mut i32) (i32.const 0))
  (global $line (mut i32) (i32.const 1))
  (global $rec_line (mut i32) (i32.const 1))
  (global $rec_row (mut i32) (i32.const 0))
  (global $width (mut i32) (i32.const -1))
  (global $rows_count (mut i32) (i32.const 0))
  (global $header (mut i32) (i32.const 0))
  (global $cols_done (mut i32) (i32.const 0))
  (global $xform_ptr (mut i32) (i32.const 0))
  (global $rows_end (mut i32) (i32.const 0))
  (global $errs_end (mut i32) (i32.const 0))
  (global $cols_end (mut i32) (i32.const 0))
  (global $out_end (mut i32) (i32.const 0))
  (global $wp (mut i32) (i32.const 0))
  (global $nfields (mut i32) (i32.const 0))
  (global $key_len (mut i32) (i32.const 0))
  (global $first_case (mut i32) (i32.const 1))
  (global $errs_has (mut i32) (i32.const 0))
  ;; scan results
  (global $s_ended (mut i32) (i32.const 0))
  (global $s_ptr (mut i32) (i32.const 0))
  (global $s_len (mut i32) (i32.const 0))
  (global $s_kind (mut i32) (i32.const 0))
  (global $s_added (mut i32) (i32.const 0))

  ;; ---- emit helpers (write at $wp) ----
  (func $w8 (param $b i32)
    (i32.store8 (global.get $wp) (local.get $b))
    (global.set $wp (i32.add (global.get $wp) (i32.const 1))))
  (func $wbytes (param $ptr i32) (param $len i32)
    (memory.copy (global.get $wp) (local.get $ptr) (local.get $len))
    (global.set $wp (i32.add (global.get $wp) (local.get $len))))
  (func $wlit (param $off i32) (param $len i32)
    (memory.copy (global.get $wp) (local.get $off) (local.get $len))
    (global.set $wp (i32.add (global.get $wp) (local.get $len))))
  (func $whex (param $d i32)
    (call $w8 (i32.load8_u (i32.add (global.get $L_HEX) (local.get $d)))))
  (func $wuint (param $n i32)
    (local $p i32) (local $d i32)
    (if (i32.eqz (local.get $n)) (then (call $w8 (i32.const 48)) (return)))
    (local.set $p (i32.add (global.get $UINT_BUF) (i32.const 20)))
    (block $done
      (loop $l
        (br_if $done (i32.eqz (local.get $n)))
        (local.set $d (i32.rem_u (local.get $n) (i32.const 10)))
        (local.set $n (i32.div_u (local.get $n) (i32.const 10)))
        (local.set $p (i32.sub (local.get $p) (i32.const 1)))
        (i32.store8 (local.get $p) (i32.add (local.get $d) (i32.const 48)))
        (br $l)))
    (call $wbytes (local.get $p) (i32.sub (i32.add (global.get $UINT_BUF) (i32.const 20)) (local.get $p))))
  ;; row value: null when $rec_row < 0, else the number
  (func $wrow
    (if (i32.lt_s (global.get $rec_row) (i32.const 0))
      (then (call $wlit (global.get $L_NULL) (i32.const 4)))
      (else (call $wuint (global.get $rec_row)))))
  ;; emit a field's bytes as a JSON string, escaping ", \, controls, CESU-8 surrogates
  (func $wjson_str (param $ptr i32) (param $len i32)
    (local $i i32) (local $b i32) (local $b1 i32) (local $b2 i32) (local $cp i32)
    (local $v v128) (local $m i32)
    (call $w8 (i32.const 34))
    (local.set $i (i32.const 0))
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        ;; fast path: 16 bytes with nothing to escape, bulk-copied
        (if (i32.ge_u (i32.sub (local.get $len) (local.get $i)) (i32.const 16))
          (then
            (local.set $v (v128.load (i32.add (local.get $ptr) (local.get $i))))
            (local.set $m (i32.or (i32.or
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 34))))
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 92)))))
              (i32.or
                (i8x16.bitmask (i8x16.lt_s (v128.xor (local.get $v) (i8x16.splat (i32.const 128))) (i8x16.splat (i32.const 160))))
                (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 237)))))))
            (if (i32.eqz (local.get $m))
              (then
                (memory.copy (global.get $wp) (i32.add (local.get $ptr) (local.get $i)) (i32.const 16))
                (global.set $wp (i32.add (global.get $wp) (i32.const 16)))
                (local.set $i (i32.add (local.get $i) (i32.const 16)))
                (br $l)))))
        (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $i))))
        (if (i32.eq (local.get $b) (i32.const 34))
          (then (call $w8 (i32.const 92)) (call $w8 (i32.const 34))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
        (if (i32.eq (local.get $b) (i32.const 92))
          (then (call $w8 (i32.const 92)) (call $w8 (i32.const 92))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
        (if (i32.lt_u (local.get $b) (i32.const 32))
          (then (call $w8 (i32.const 92)) (call $w8 (i32.const 117))
            (call $w8 (i32.const 48)) (call $w8 (i32.const 48))
            (call $whex (i32.shr_u (local.get $b) (i32.const 4)))
            (call $whex (i32.and (local.get $b) (i32.const 15)))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
        (if (i32.and (i32.eq (local.get $b) (i32.const 237))
              (i32.and (i32.lt_u (i32.add (local.get $i) (i32.const 2)) (local.get $len))
                (i32.and (i32.eq (i32.and (i32.load8_u (i32.add (local.get $ptr) (i32.add (local.get $i) (i32.const 1)))) (i32.const 240)) (i32.const 160))
                  (i32.eq (i32.and (i32.load8_u (i32.add (local.get $ptr) (i32.add (local.get $i) (i32.const 2)))) (i32.const 192)) (i32.const 128)))))
          (then
            (local.set $b1 (i32.load8_u (i32.add (local.get $ptr) (i32.add (local.get $i) (i32.const 1)))))
            (local.set $b2 (i32.load8_u (i32.add (local.get $ptr) (i32.add (local.get $i) (i32.const 2)))))
            (local.set $cp (i32.add (i32.const 55296)
              (i32.add (i32.shl (i32.and (local.get $b1) (i32.const 15)) (i32.const 6))
                (i32.and (local.get $b2) (i32.const 63)))))
            (call $w8 (i32.const 92)) (call $w8 (i32.const 117))
            (call $whex (i32.and (i32.shr_u (local.get $cp) (i32.const 12)) (i32.const 15)))
            (call $whex (i32.and (i32.shr_u (local.get $cp) (i32.const 8)) (i32.const 15)))
            (call $whex (i32.and (i32.shr_u (local.get $cp) (i32.const 4)) (i32.const 15)))
            (call $whex (i32.and (local.get $cp) (i32.const 15)))
            (local.set $i (i32.add (local.get $i) (i32.const 3))) (br $l)))
        (call $w8 (local.get $b))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (call $w8 (i32.const 34)))

  ;; ---- small helpers ----
  ;; byte at $i, or 0 past the text end (safe lookahead)
  (func $b8 (param $i i32) (result i32)
    (if (result i32) (i32.ge_u (local.get $i) (global.get $t_end))
      (then (i32.const 0))
      (else (i32.load8_u (local.get $i)))))
  ;; field descriptors: 12 bytes each (ptr, len, kind) at FIELDS_BASE
  (func $push_field (param $ptr i32) (param $len i32) (param $kind i32)
    (local $base i32)
    (local.set $base (i32.add (global.get $FIELDS_BASE) (i32.mul (global.get $nfields) (i32.const 12))))
    (i32.store (local.get $base) (local.get $ptr))
    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $len))
    (i32.store (i32.add (local.get $base) (i32.const 8)) (local.get $kind))
    (global.set $nfields (i32.add (global.get $nfields) (i32.const 1))))
  (func $field_len (param $i i32) (result i32)
    (i32.load (i32.add (i32.add (global.get $FIELDS_BASE) (i32.mul (local.get $i) (i32.const 12))) (i32.const 4))))
  (func $emit_field (param $i i32)
    (local $base i32)
    (local.set $base (i32.add (global.get $FIELDS_BASE) (i32.mul (local.get $i) (i32.const 12))))
    (call $wjson_str (i32.load (local.get $base)) (i32.load (i32.add (local.get $base) (i32.const 4)))))
  (func $emit_fields_range (param $a i32) (param $b i32)
    (local $i i32)
    (local.set $i (local.get $a))
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $b)))
        (if (i32.gt_u (local.get $i) (local.get $a)) (then (call $w8 (i32.const 44))))
        (call $emit_field (local.get $i))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l))))
  ;; ---- error emitters (append to ERRS buffer) ----
  (func $err_begin
    (global.set $wp (global.get $errs_end))
    (if (global.get $errs_has) (then (call $w8 (i32.const 44)))))
  (func $err_head (param $code_off i32) (param $code_len i32)
    (call $wlit (global.get $L_CODE) (i32.const 9))
    (call $wlit (local.get $code_off) (local.get $code_len))
    (call $wlit (global.get $L_LINE) (i32.const 9))
    (call $wuint (global.get $rec_line))
    (call $wlit (global.get $L_ROW) (i32.const 7))
    (call $wrow))
  (func $err_end
    (call $w8 (i32.const 125))
    (global.set $errs_end (global.get $wp))
    (global.set $errs_has (i32.const 1)))
  (func $err_code (param $code_off i32) (param $code_len i32)
    (call $err_begin)
    (call $err_head (local.get $code_off) (local.get $code_len))
    (call $err_end))
  (func $err_short (param $n i32)
    (call $err_begin)
    (call $err_head (global.get $L_SHORT) (i32.const 9))
    (call $wlit (global.get $L_FIELDS) (i32.const 10))
    (call $wuint (local.get $n))
    (call $err_end))
  (func $err_long (param $from i32)
    (call $err_begin)
    (call $err_head (global.get $L_LONG) (i32.const 8))
    (call $wlit (global.get $L_EXTRA) (i32.const 9))
    (call $w8 (i32.const 91))
    (call $emit_fields_range (local.get $from) (global.get $nfields))
    (call $w8 (i32.const 93))
    (call $err_end))

  ;; ---- JSON unescape helpers ----
  (func $hexval (param $b i32) (result i32)
    (if (result i32) (i32.and (i32.ge_u (local.get $b) (i32.const 48)) (i32.le_u (local.get $b) (i32.const 57)))
      (then (i32.sub (local.get $b) (i32.const 48)))
      (else (if (result i32) (i32.and (i32.ge_u (local.get $b) (i32.const 97)) (i32.le_u (local.get $b) (i32.const 102)))
        (then (i32.sub (local.get $b) (i32.const 87)))
        (else (i32.sub (local.get $b) (i32.const 55)))))))
  ;; read 4 hex digits at $in_pos, advance past them
  (func $hex4 (result i32)
    (local $v i32)
    (local.set $v (call $hexval (i32.load8_u (global.get $in_pos))))
    (local.set $v (i32.add (i32.shl (local.get $v) (i32.const 4)) (call $hexval (i32.load8_u (i32.add (global.get $in_pos) (i32.const 1))))))
    (local.set $v (i32.add (i32.shl (local.get $v) (i32.const 4)) (call $hexval (i32.load8_u (i32.add (global.get $in_pos) (i32.const 2))))))
    (local.set $v (i32.add (i32.shl (local.get $v) (i32.const 4)) (call $hexval (i32.load8_u (i32.add (global.get $in_pos) (i32.const 3))))))
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 4)))
    (local.get $v))
  ;; read 4 hex digits at $p, no advance
  (func $hex4_at (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (call $hexval (i32.load8_u (local.get $p))))
    (local.set $v (i32.add (i32.shl (local.get $v) (i32.const 4)) (call $hexval (i32.load8_u (i32.add (local.get $p) (i32.const 1))))))
    (local.set $v (i32.add (i32.shl (local.get $v) (i32.const 4)) (call $hexval (i32.load8_u (i32.add (local.get $p) (i32.const 2))))))
    (local.set $v (i32.add (i32.shl (local.get $v) (i32.const 4)) (call $hexval (i32.load8_u (i32.add (local.get $p) (i32.const 3))))))
    (local.get $v))
  ;; encode code point $cp as UTF-8 at $w, return new write pointer
  (func $utf8_encode (param $cp i32) (param $w i32) (result i32)
    (if (result i32) (i32.lt_u (local.get $cp) (i32.const 128))
      (then (i32.store8 (local.get $w) (local.get $cp)) (i32.add (local.get $w) (i32.const 1)))
      (else (if (result i32) (i32.lt_u (local.get $cp) (i32.const 2048))
        (then
          (i32.store8 (local.get $w) (i32.or (i32.const 192) (i32.shr_u (local.get $cp) (i32.const 6))))
          (i32.store8 (i32.add (local.get $w) (i32.const 1)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
          (i32.add (local.get $w) (i32.const 2)))
        (else (if (result i32) (i32.lt_u (local.get $cp) (i32.const 65536))
          (then
            (i32.store8 (local.get $w) (i32.or (i32.const 224) (i32.shr_u (local.get $cp) (i32.const 12))))
            (i32.store8 (i32.add (local.get $w) (i32.const 1)) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 6)) (i32.const 63))))
            (i32.store8 (i32.add (local.get $w) (i32.const 2)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
            (i32.add (local.get $w) (i32.const 3)))
          (else
            (i32.store8 (local.get $w) (i32.or (i32.const 240) (i32.shr_u (local.get $cp) (i32.const 18))))
            (i32.store8 (i32.add (local.get $w) (i32.const 1)) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 12)) (i32.const 63))))
            (i32.store8 (i32.add (local.get $w) (i32.const 2)) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 6)) (i32.const 63))))
            (i32.store8 (i32.add (local.get $w) (i32.const 3)) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63))))
            (i32.add (local.get $w) (i32.const 4)))))))))

  ;; ---- unquoted field scan ----
  ;; Sets $s_ended (0 comma, 1 line break, 2 end), $s_ptr/$s_len/$s_kind, $s_added (kept bytes).
  ;; $pos advances past the delimiter. Lone CRs are dropped and reported as stray_cr.
  (func $scan_unquoted
    (local $fstart i32) (local $fend i32) (local $stray i32) (local $ended i32)
    (local $v v128) (local $m i32) (local $k i32) (local $dpos i32) (local $b i32)
    (local $i i32) (local $w i32)
    (local.set $fstart (global.get $pos))
    (local.set $fend (global.get $t_end))
    (local.set $stray (i32.const 0))
    (local.set $ended (i32.const 2))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (global.get $pos) (global.get $t_end)))
        (if (i32.ge_u (i32.sub (global.get $t_end) (global.get $pos)) (i32.const 16))
          (then
            (local.set $v (v128.load (global.get $pos)))
            (local.set $m (i32.or (i32.or
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 44))))
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 10)))))
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 13))))))
            (if (i32.eqz (local.get $m))
              (then (global.set $pos (i32.add (global.get $pos) (i32.const 16))) (br $scan))
              (else
                (local.set $k (i32.ctz (local.get $m)))
                (local.set $dpos (i32.add (global.get $pos) (local.get $k)))
                (local.set $b (i32.load8_u (local.get $dpos)))
                (if (i32.eq (local.get $b) (i32.const 44))
                  (then
                    (local.set $fend (local.get $dpos))
                    (global.set $pos (i32.add (local.get $dpos) (i32.const 1)))
                    (local.set $ended (i32.const 0)) (br $done)))
                (if (i32.eq (local.get $b) (i32.const 10))
                  (then
                    (local.set $fend (local.get $dpos))
                    (global.set $pos (i32.add (local.get $dpos) (i32.const 1)))
                    (global.set $line (i32.add (global.get $line) (i32.const 1)))
                    (local.set $ended (i32.const 1)) (br $done)))
                (if (i32.and
                      (i32.lt_u (i32.add (local.get $dpos) (i32.const 1)) (global.get $t_end))
                      (i32.eq (i32.load8_u (i32.add (local.get $dpos) (i32.const 1))) (i32.const 10)))
                  (then
                    (local.set $fend (local.get $dpos))
                    (global.set $pos (i32.add (local.get $dpos) (i32.const 2)))
                    (global.set $line (i32.add (global.get $line) (i32.const 1)))
                    (local.set $ended (i32.const 1)) (br $done))
                  (else
                    (call $err_code (global.get $L_STRAY) (i32.const 8))
                    (local.set $stray (i32.add (local.get $stray) (i32.const 1)))
                    (global.set $pos (i32.add (local.get $dpos) (i32.const 1)))
                    (if (i32.ge_u (global.get $pos) (global.get $t_end))
                      (then (local.set $fend (global.get $t_end)) (local.set $ended (i32.const 2)) (br $done)))
                    (br $scan))))))
          (else
            (local.set $b (i32.load8_u (global.get $pos)))
            (if (i32.eq (local.get $b) (i32.const 44))
              (then
                (local.set $fend (global.get $pos))
                (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                (local.set $ended (i32.const 0)) (br $done)))
            (if (i32.eq (local.get $b) (i32.const 10))
              (then
                (local.set $fend (global.get $pos))
                (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                (global.set $line (i32.add (global.get $line) (i32.const 1)))
                (local.set $ended (i32.const 1)) (br $done)))
            (if (i32.eq (local.get $b) (i32.const 13))
              (then
                (if (i32.and
                      (i32.lt_u (i32.add (global.get $pos) (i32.const 1)) (global.get $t_end))
                      (i32.eq (i32.load8_u (i32.add (global.get $pos) (i32.const 1))) (i32.const 10)))
                  (then
                    (local.set $fend (global.get $pos))
                    (global.set $pos (i32.add (global.get $pos) (i32.const 2)))
                    (global.set $line (i32.add (global.get $line) (i32.const 1)))
                    (local.set $ended (i32.const 1)) (br $done))
                  (else
                    (call $err_code (global.get $L_STRAY) (i32.const 8))
                    (local.set $stray (i32.add (local.get $stray) (i32.const 1)))
                    (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                    (if (i32.ge_u (global.get $pos) (global.get $t_end))
                      (then (local.set $fend (global.get $t_end)) (local.set $ended (i32.const 2)) (br $done)))
                    (br $scan))))
              (else
                (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                (br $scan)))))))
    (if (i32.eqz (local.get $stray))
      (then
        (global.set $s_ptr (local.get $fstart))
        (global.set $s_len (i32.sub (local.get $fend) (local.get $fstart)))
        (global.set $s_kind (i32.const 0))
        (global.set $s_added (i32.sub (local.get $fend) (local.get $fstart))))
      (else
        (global.set $s_ptr (global.get $xform_ptr))
        (local.set $i (local.get $fstart))
        (local.set $w (global.get $xform_ptr))
        (block $mdone
          (loop $m
            (br_if $mdone (i32.ge_u (local.get $i) (local.get $fend)))
            (local.set $b (i32.load8_u (local.get $i)))
            (if (i32.and (i32.eq (local.get $b) (i32.const 13))
                  (i32.ne (call $b8 (i32.add (local.get $i) (i32.const 1))) (i32.const 10)))
              (then (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $m)))
            (i32.store8 (local.get $w) (local.get $b))
            (local.set $w (i32.add (local.get $w) (i32.const 1)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $m)))
        (global.set $s_len (i32.sub (local.get $w) (global.get $s_ptr)))
        (global.set $s_kind (i32.const 1))
        (global.set $s_added (global.get $s_len))
        (global.set $xform_ptr (local.get $w))))
    (global.set $s_ended (local.get $ended)))

  ;; ---- quoted field scan ----
  ;; Same $s_* contract as $scan_unquoted. A quote that never closes is a literal
  ;; quote and the rest is re-read as unquoted (unterminated_quote).
  (func $scan_quoted
    (local $open i32) (local $q i32) (local $hasD i32) (local $hasNL i32)
    (local $v v128) (local $mQ i32) (local $mNL i32) (local $k i32) (local $qpos i32)
    (local $b i32) (local $i i32) (local $w i32)
    (local $fptr i32) (local $flen i32) (local $fkind i32)
    (local $jptr i32) (local $jlen i32) (local $jended i32)
    (local.set $open (global.get $pos))
    (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
    (local.set $q (i32.const -1))
    (local.set $hasD (i32.const 0))
    (local.set $hasNL (i32.const 0))
    (block $scan_done
      (loop $scan
        (if (i32.ge_u (global.get $pos) (global.get $t_end)) (then (br $scan_done)))
        (if (i32.ge_u (i32.sub (global.get $t_end) (global.get $pos)) (i32.const 16))
          (then
            (local.set $v (v128.load (global.get $pos)))
            (local.set $mQ (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 34)))))
            (local.set $mNL (i32.or
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 10))))
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 13))))))
            (if (i32.eqz (local.get $mQ))
              (then
                (if (i32.ne (local.get $mNL) (i32.const 0)) (then (local.set $hasNL (i32.const 1))))
                (global.set $pos (i32.add (global.get $pos) (i32.const 16)))
                (br $scan))
              (else
                (local.set $k (i32.ctz (local.get $mQ)))
                (local.set $qpos (i32.add (global.get $pos) (local.get $k)))
                (if (i32.ne (i32.and (local.get $mNL) (i32.sub (i32.shl (i32.const 1) (local.get $k)) (i32.const 1))) (i32.const 0))
                  (then (local.set $hasNL (i32.const 1))))
                (if (i32.eq (call $b8 (i32.add (local.get $qpos) (i32.const 1))) (i32.const 34))
                  (then
                    (local.set $hasD (i32.const 1))
                    (global.set $pos (i32.add (local.get $qpos) (i32.const 2)))
                    (br $scan))
                  (else
                    (local.set $q (local.get $qpos))
                    (global.set $pos (i32.add (local.get $qpos) (i32.const 1)))
                    (br $scan_done))))))
          (else
            (local.set $b (i32.load8_u (global.get $pos)))
            (if (i32.eq (local.get $b) (i32.const 34))
              (then
                (if (i32.eq (call $b8 (i32.add (global.get $pos) (i32.const 1))) (i32.const 34))
                  (then
                    (local.set $hasD (i32.const 1))
                    (global.set $pos (i32.add (global.get $pos) (i32.const 2)))
                    (br $scan))
                  (else
                    (local.set $q (global.get $pos))
                    (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                    (br $scan_done))))
              (else
                (if (i32.or (i32.eq (local.get $b) (i32.const 10)) (i32.eq (local.get $b) (i32.const 13)))
                  (then (local.set $hasNL (i32.const 1))))
                (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                (br $scan)))))))
    (if (i32.lt_s (local.get $q) (i32.const 0))
      (then
        (call $err_code (global.get $L_UNTERM) (i32.const 18))
        (global.set $pos (i32.add (local.get $open) (i32.const 1)))
        (call $scan_unquoted)
        (local.set $fptr (global.get $xform_ptr))
        (i32.store8 (global.get $xform_ptr) (i32.const 34))
        (memory.copy (i32.add (global.get $xform_ptr) (i32.const 1)) (global.get $s_ptr) (global.get $s_len))
        (global.set $xform_ptr (i32.add (global.get $xform_ptr) (i32.add (global.get $s_len) (i32.const 1))))
        (global.set $s_ptr (local.get $fptr))
        (global.set $s_len (i32.add (global.get $s_len) (i32.const 1)))
        (global.set $s_kind (i32.const 1))
        (global.set $s_added (global.get $s_len))
        (return)))
    (if (i32.or (local.get $hasD) (local.get $hasNL))
      (then
        (local.set $fptr (global.get $xform_ptr))
        (local.set $i (i32.add (local.get $open) (i32.const 1)))
        (local.set $w (global.get $xform_ptr))
        (block $mdone
          (loop $m
            (br_if $mdone (i32.ge_u (local.get $i) (local.get $q)))
            (local.set $b (i32.load8_u (local.get $i)))
            (if (i32.eq (local.get $b) (i32.const 34))
              (then
                (i32.store8 (local.get $w) (i32.const 34))
                (local.set $w (i32.add (local.get $w) (i32.const 1)))
                (local.set $i (i32.add (local.get $i) (i32.const 2)))
                (br $m)))
            (if (i32.eq (local.get $b) (i32.const 13))
              (then
                (i32.store8 (local.get $w) (i32.const 10))
                (local.set $w (i32.add (local.get $w) (i32.const 1)))
                (global.set $line (i32.add (global.get $line) (i32.const 1)))
                (if (i32.eq (call $b8 (i32.add (local.get $i) (i32.const 1))) (i32.const 10))
                  (then (local.set $i (i32.add (local.get $i) (i32.const 2))))
                  (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))
                (br $m)))
            (if (i32.eq (local.get $b) (i32.const 10))
              (then
                (i32.store8 (local.get $w) (i32.const 10))
                (local.set $w (i32.add (local.get $w) (i32.const 1)))
                (global.set $line (i32.add (global.get $line) (i32.const 1)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $m)))
            (i32.store8 (local.get $w) (local.get $b))
            (local.set $w (i32.add (local.get $w) (i32.const 1)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $m)))
        (local.set $flen (i32.sub (local.get $w) (local.get $fptr)))
        (local.set $fkind (i32.const 1))
        (global.set $xform_ptr (local.get $w)))
      (else
        (local.set $fptr (i32.add (local.get $open) (i32.const 1)))
        (local.set $flen (i32.sub (local.get $q) (i32.add (local.get $open) (i32.const 1))))
        (local.set $fkind (i32.const 0))))
    (if (i32.ge_u (global.get $pos) (global.get $t_end))
      (then
        (global.set $s_ptr (local.get $fptr))
        (global.set $s_len (local.get $flen))
        (global.set $s_kind (local.get $fkind))
        (global.set $s_added (local.get $flen))
        (global.set $s_ended (i32.const 2))
        (return)))
    (local.set $b (i32.load8_u (global.get $pos)))
    (if (i32.eq (local.get $b) (i32.const 44))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (global.set $s_ptr (local.get $fptr))
        (global.set $s_len (local.get $flen))
        (global.set $s_kind (local.get $fkind))
        (global.set $s_added (local.get $flen))
        (global.set $s_ended (i32.const 0))
        (return)))
    (if (i32.eq (local.get $b) (i32.const 10))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
        (global.set $line (i32.add (global.get $line) (i32.const 1)))
        (global.set $s_ptr (local.get $fptr))
        (global.set $s_len (local.get $flen))
        (global.set $s_kind (local.get $fkind))
        (global.set $s_added (local.get $flen))
        (global.set $s_ended (i32.const 1))
        (return)))
    (if (i32.and (i32.eq (local.get $b) (i32.const 13))
          (i32.eq (call $b8 (i32.add (global.get $pos) (i32.const 1))) (i32.const 10)))
      (then
        (global.set $pos (i32.add (global.get $pos) (i32.const 2)))
        (global.set $line (i32.add (global.get $line) (i32.const 1)))
        (global.set $s_ptr (local.get $fptr))
        (global.set $s_len (local.get $flen))
        (global.set $s_kind (local.get $fkind))
        (global.set $s_added (local.get $flen))
        (global.set $s_ended (i32.const 1))
        (return)))
    (call $scan_unquoted)
    (local.set $jptr (global.get $s_ptr))
    (local.set $jlen (global.get $s_len))
    (local.set $jended (global.get $s_ended))
    (if (i32.gt_u (global.get $s_added) (i32.const 0))
      (then
        (call $err_code (global.get $L_JUNK) (i32.const 10))
        (memory.copy (global.get $xform_ptr) (local.get $fptr) (local.get $flen))
        (memory.copy (i32.add (global.get $xform_ptr) (local.get $flen)) (local.get $jptr) (local.get $jlen))
        (global.set $s_ptr (global.get $xform_ptr))
        (global.set $s_len (i32.add (local.get $flen) (local.get $jlen)))
        (global.set $s_kind (i32.const 1))
        (global.set $s_added (global.get $s_len))
        (global.set $xform_ptr (i32.add (global.get $xform_ptr) (global.get $s_len))))
      (else
        (global.set $s_ptr (local.get $fptr))
        (global.set $s_len (local.get $flen))
        (global.set $s_kind (local.get $fkind))
        (global.set $s_added (local.get $flen))))
    (global.set $s_ended (local.get $jended)))

  ;; ---- one CSV case: text in TEXT region, answer appended to OUT ----
  (func $run_case
    (local $ended i32) (local $quoted i32) (local $c i32)
    (global.set $xform_ptr (global.get $XFORM_BASE))
    (global.set $rows_end (global.get $ROWS_BASE))
    (global.set $errs_end (global.get $ERRS_BASE))
    (global.set $cols_end (global.get $COLS_BASE))
    (global.set $errs_has (i32.const 0))
    (global.set $width (i32.const -1))
    (global.set $cols_done (i32.const 0))
    (global.set $rows_count (i32.const 0))
    (global.set $line (i32.const 1))
    (if (i32.and (i32.ge_u (global.get $text_len) (i32.const 3))
          (i32.and (i32.eq (i32.load8_u (global.get $TEXT_BASE)) (i32.const 239))
            (i32.and (i32.eq (i32.load8_u (i32.add (global.get $TEXT_BASE) (i32.const 1))) (i32.const 187))
              (i32.eq (i32.load8_u (i32.add (global.get $TEXT_BASE) (i32.const 2))) (i32.const 191)))))
      (then (global.set $pos (i32.add (global.get $TEXT_BASE) (i32.const 3))))
      (else (global.set $pos (global.get $TEXT_BASE))))
    (block $records_done
      (loop $records
        (block $skip_done
          (loop $skip
            (br_if $skip_done (i32.ge_u (global.get $pos) (global.get $t_end)))
            (local.set $c (i32.load8_u (global.get $pos)))
            (if (i32.eq (local.get $c) (i32.const 10))
              (then
                (global.set $pos (i32.add (global.get $pos) (i32.const 1)))
                (global.set $line (i32.add (global.get $line) (i32.const 1)))
                (br $skip)))
            (if (i32.and (i32.eq (local.get $c) (i32.const 13))
                  (i32.eq (call $b8 (i32.add (global.get $pos) (i32.const 1))) (i32.const 10)))
              (then
                (global.set $pos (i32.add (global.get $pos) (i32.const 2)))
                (global.set $line (i32.add (global.get $line) (i32.const 1)))
                (br $skip)))
            (br $skip_done)))
        (br_if $records_done (i32.ge_u (global.get $pos) (global.get $t_end)))
        (global.set $rec_line (global.get $line))
        (if (i32.and (global.get $header) (i32.eqz (global.get $cols_done)))
          (then (global.set $rec_row (i32.const -1)))
          (else (global.set $rec_row (global.get $rows_count))))
        (global.set $nfields (i32.const 0))
        (loop $fields
          (if (i32.eq (i32.load8_u (global.get $pos)) (i32.const 34))
            (then (local.set $quoted (i32.const 1)) (call $scan_quoted))
            (else (local.set $quoted (i32.const 0)) (call $scan_unquoted)))
          (call $push_field (global.get $s_ptr) (global.get $s_len) (global.get $s_kind))
          (local.set $ended (global.get $s_ended))
          (br_if $fields (i32.eq (local.get $ended) (i32.const 0))))
        (if (i32.and (i32.and (i32.eq (global.get $nfields) (i32.const 1))
                (i32.eq (call $field_len (i32.const 0)) (i32.const 0)))
              (i32.eqz (local.get $quoted)))
          (then (br $records)))
        (if (i32.lt_s (global.get $width) (i32.const 0))
          (then (global.set $width (global.get $nfields))))
        (if (i32.and (global.get $header) (i32.eqz (global.get $cols_done)))
          (then
            (global.set $wp (global.get $cols_end))
            (call $w8 (i32.const 91))
            (call $emit_fields_range (i32.const 0) (global.get $nfields))
            (call $w8 (i32.const 93))
            (global.set $cols_end (global.get $wp))
            (global.set $cols_done (i32.const 1))
            (br $records))
          (else
            (if (i32.lt_u (global.get $nfields) (global.get $width))
              (then
                (call $err_short (global.get $nfields))
                (block $pad_done
                  (loop $pad
                    (br_if $pad_done (i32.ge_u (global.get $nfields) (global.get $width)))
                    (call $push_field (i32.const 0) (i32.const 0) (i32.const 0))
                    (br $pad))))
              (else
                (if (i32.gt_u (global.get $nfields) (global.get $width))
                  (then (call $err_long (global.get $width))))))
            (global.set $wp (global.get $rows_end))
            (if (i32.gt_u (global.get $rows_count) (i32.const 0)) (then (call $w8 (i32.const 44))))
            (call $w8 (i32.const 91))
            (call $emit_fields_range (i32.const 0) (global.get $width))
            (call $w8 (i32.const 93))
            (global.set $rows_end (global.get $wp))
            (global.set $rows_count (i32.add (global.get $rows_count) (i32.const 1)))
            (br $records)))))
    (global.set $wp (global.get $out_end))
    (if (i32.eqz (global.get $first_case)) (then (call $w8 (i32.const 44))))
    (call $wlit (global.get $L_COLUMNS) (i32.const 11))
    (if (i32.eqz (global.get $header))
      (then (call $wlit (global.get $L_NULL) (i32.const 4)))
      (else
        (if (global.get $cols_done)
          (then (call $wbytes (global.get $COLS_BASE) (i32.sub (global.get $cols_end) (global.get $COLS_BASE))))
          (else (call $wlit (global.get $L_EMPTY) (i32.const 2))))))
    (call $wlit (global.get $L_ROWS) (i32.const 9))
    (call $wbytes (global.get $ROWS_BASE) (i32.sub (global.get $rows_end) (global.get $ROWS_BASE)))
    (call $wlit (global.get $L_ERRORS) (i32.const 12))
    (call $wbytes (global.get $ERRS_BASE) (i32.sub (global.get $errs_end) (global.get $ERRS_BASE)))
    (call $wlit (global.get $L_CLOSE) (i32.const 2))
    (global.set $out_end (global.get $wp))
    (global.set $first_case (i32.const 0)))

  ;; ---- JSON layer over cases.json ----
  (func $skip_ws
    (local $b i32)
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (global.get $in_pos) (global.get $in_len)))
        (local.set $b (i32.load8_u (global.get $in_pos)))
        (if (i32.or (i32.or (i32.eq (local.get $b) (i32.const 32)) (i32.eq (local.get $b) (i32.const 9)))
              (i32.or (i32.eq (local.get $b) (i32.const 10)) (i32.eq (local.get $b) (i32.const 13))))
          (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1))) (br $l))
          (else (br $done))))))
  ;; combine a high surrogate in $cp with a following \uDC00-\uDFFF escape, else $cp unchanged
  (func $maybe_pair (param $cp i32) (result i32)
    (local $lo i32)
    (if (result i32) (i32.and (i32.ge_u (local.get $cp) (i32.const 55296)) (i32.le_u (local.get $cp) (i32.const 56319)))
      (then
        (if (result i32) (i32.and (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 92))
              (i32.eq (i32.load8_u (i32.add (global.get $in_pos) (i32.const 1))) (i32.const 117)))
          (then
            (local.set $lo (call $hex4_at (i32.add (global.get $in_pos) (i32.const 2))))
            (if (result i32) (i32.and (i32.ge_u (local.get $lo) (i32.const 56320)) (i32.le_u (local.get $lo) (i32.const 57343)))
              (then
                (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 6)))
                (i32.add (i32.const 65536)
                  (i32.add (i32.shl (i32.sub (local.get $cp) (i32.const 55296)) (i32.const 10))
                    (i32.sub (local.get $lo) (i32.const 56320)))))
              (else (local.get $cp))))
          (else (local.get $cp))))
      (else (local.get $cp))))
  ;; parse a JSON string at $in_pos (opening quote) into TEXT, unescaping
  (func $parse_text_string
    (local $tw i32) (local $b i32) (local $e i32) (local $cp i32)
    (local $v v128) (local $m i32)
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
    (local.set $tw (global.get $TEXT_BASE))
    (block $done
      (loop $l
        ;; fast path: 16 bytes with no quote or backslash, bulk-copied
        (if (i32.ge_u (i32.sub (global.get $in_len) (global.get $in_pos)) (i32.const 16))
          (then
            (local.set $v (v128.load (global.get $in_pos)))
            (local.set $m (i32.or
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 34))))
              (i8x16.bitmask (i8x16.eq (local.get $v) (i8x16.splat (i32.const 92))))))
            (if (i32.eqz (local.get $m))
              (then
                (memory.copy (local.get $tw) (global.get $in_pos) (i32.const 16))
                (local.set $tw (i32.add (local.get $tw) (i32.const 16)))
                (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 16)))
                (br $l)))))
        (local.set $b (i32.load8_u (global.get $in_pos)))
        (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
        (if (i32.eq (local.get $b) (i32.const 34)) (then (br $done)))
        (if (i32.eq (local.get $b) (i32.const 92))
          (then
            (local.set $e (i32.load8_u (global.get $in_pos)))
            (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
            (if (i32.eq (local.get $e) (i32.const 117))
              (then
                (local.set $cp (call $hex4))
                (local.set $cp (call $maybe_pair (local.get $cp)))
                (local.set $tw (call $utf8_encode (local.get $cp) (local.get $tw)))
                (br $l))
              (else
                (if (i32.eq (local.get $e) (i32.const 34)) (then (i32.store8 (local.get $tw) (i32.const 34)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 92)) (then (i32.store8 (local.get $tw) (i32.const 92)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 47)) (then (i32.store8 (local.get $tw) (i32.const 47)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 98)) (then (i32.store8 (local.get $tw) (i32.const 8)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 102)) (then (i32.store8 (local.get $tw) (i32.const 12)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 110)) (then (i32.store8 (local.get $tw) (i32.const 10)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 114)) (then (i32.store8 (local.get $tw) (i32.const 13)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (if (i32.eq (local.get $e) (i32.const 116)) (then (i32.store8 (local.get $tw) (i32.const 9)) (local.set $tw (i32.add (local.get $tw) (i32.const 1))) (br $l)))
                (i32.store8 (local.get $tw) (local.get $e))
                (local.set $tw (i32.add (local.get $tw) (i32.const 1)))
                (br $l))))
          (else
            (i32.store8 (local.get $tw) (local.get $b))
            (local.set $tw (i32.add (local.get $tw) (i32.const 1)))
            (br $l)))))
    (global.set $text_len (i32.sub (local.get $tw) (global.get $TEXT_BASE)))
    (global.set $t_end (local.get $tw))
    (memory.fill (local.get $tw) (i32.const 0) (i32.const 32)))
  ;; object key into KEY_BUF (escapes skipped, keys here never hold any)
  (func $parse_key
    (local $b i32) (local $kp i32)
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
    (local.set $kp (global.get $KEY_BUF))
    (block $done
      (loop $l
        (local.set $b (i32.load8_u (global.get $in_pos)))
        (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
        (if (i32.eq (local.get $b) (i32.const 34)) (then (br $done)))
        (if (i32.eq (local.get $b) (i32.const 92))
          (then
            (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 117))
              (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 5))))
              (else (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))))
            (br $l)))
        (i32.store8 (local.get $kp) (local.get $b))
        (local.set $kp (i32.add (local.get $kp) (i32.const 1)))
        (br $l)))
    (global.set $key_len (i32.sub (local.get $kp) (global.get $KEY_BUF))))
  (func $key_is (param $off i32) (param $len i32) (result i32)
    (local $i i32) (local $ok i32)
    (if (result i32) (i32.ne (global.get $key_len) (local.get $len))
      (then (i32.const 0))
      (else
        (local.set $i (i32.const 0))
        (local.set $ok (i32.const 1))
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
            (if (i32.ne (i32.load8_u (i32.add (global.get $KEY_BUF) (local.get $i)))
                        (i32.load8_u (i32.add (local.get $off) (local.get $i))))
              (then (local.set $ok (i32.const 0)) (br $done)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.get $ok))))
  (func $skip_string
    (local $b i32)
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
    (block $done
      (loop $l
        (local.set $b (i32.load8_u (global.get $in_pos)))
        (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
        (if (i32.eq (local.get $b) (i32.const 34)) (then (br $done)))
        (if (i32.eq (local.get $b) (i32.const 92))
          (then
            (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 117))
              (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 5))))
              (else (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))))))
        (br $l))))
  (func $skip_nested
    (local $depth i32) (local $b i32)
    (local.set $depth (i32.const 1))
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
    (block $done
      (loop $l
        (br_if $done (i32.eqz (local.get $depth)))
        (local.set $b (i32.load8_u (global.get $in_pos)))
        (if (i32.eq (local.get $b) (i32.const 34))
          (then (call $skip_string) (br $l)))
        (if (i32.or (i32.eq (local.get $b) (i32.const 123)) (i32.eq (local.get $b) (i32.const 91)))
          (then
            (local.set $depth (i32.add (local.get $depth) (i32.const 1)))
            (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
            (br $l)))
        (if (i32.or (i32.eq (local.get $b) (i32.const 125)) (i32.eq (local.get $b) (i32.const 93)))
          (then
            (local.set $depth (i32.sub (local.get $depth) (i32.const 1)))
            (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
            (br $l)))
        (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
        (br $l))))
  (func $skip_value
    (local $b i32)
    (local.set $b (i32.load8_u (global.get $in_pos)))
    (if (i32.eq (local.get $b) (i32.const 34)) (then (call $skip_string) (return)))
    (if (i32.or (i32.eq (local.get $b) (i32.const 123)) (i32.eq (local.get $b) (i32.const 91)))
      (then (call $skip_nested) (return)))
    (if (i32.eq (local.get $b) (i32.const 116)) (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 4))) (return)))
    (if (i32.eq (local.get $b) (i32.const 102)) (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 5))) (return)))
    (if (i32.eq (local.get $b) (i32.const 110)) (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 4))) (return)))
    (block $done
      (loop $l
        (local.set $b (i32.load8_u (global.get $in_pos)))
        (if (i32.or (i32.and (i32.ge_u (local.get $b) (i32.const 48)) (i32.le_u (local.get $b) (i32.const 57)))
              (i32.or (i32.eq (local.get $b) (i32.const 46))
                (i32.or (i32.eq (local.get $b) (i32.const 101))
                  (i32.or (i32.eq (local.get $b) (i32.const 69))
                    (i32.or (i32.eq (local.get $b) (i32.const 43)) (i32.eq (local.get $b) (i32.const 45)))))))
          (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1))) (br $l))
          (else (br $done))))))
  (func $parse_bool
    (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 116))
      (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 4))) (global.set $header (i32.const 1)))
      (else (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 5))) (global.set $header (i32.const 0)))))
  ;; parse one JSON object: $which 0 = case (dispatch on "input"), 1 = input (dispatch on "text"/"header")
  (func $parse_object (param $which i32)
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
    (call $skip_ws)
    (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 125))
      (then (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1))) (return)))
    (block $done
      (loop $l
        (call $parse_key)
        (call $skip_ws)
        (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
        (call $skip_ws)
        (if (i32.eq (local.get $which) (i32.const 1))
          (then
            (if (call $key_is (global.get $L_TEXT) (i32.const 4))
              (then (call $parse_text_string))
              (else
                (if (call $key_is (global.get $L_HEADER) (i32.const 6))
                  (then (call $parse_bool))
                  (else (call $skip_value))))))
          (else
            (if (call $key_is (global.get $L_INPUT) (i32.const 5))
              (then (call $parse_object (i32.const 1)))
              (else (call $skip_value)))))
        (call $skip_ws)
        (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 44))
          (then
            (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
            (call $skip_ws)
            (br $l))
          (else (br $done)))))
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1))))

  ;; ---- entry: input is cases.json bytes at address 0, returns answers.json length (bytes at OUT_BASE) ----
  (func (export "run") (param $len i32) (result i32)
    (global.set $in_len (local.get $len))
    (global.set $in_pos (i32.const 0))
    (global.set $out_end (global.get $OUT_BASE))
    (global.set $first_case (i32.const 1))
    (global.set $wp (global.get $out_end))
    (call $w8 (i32.const 91))
    (global.set $out_end (global.get $wp))
    (call $skip_ws)
    (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
    (block $all
      (loop $cases
        (call $skip_ws)
        (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 93)) (then (br $all)))
        (global.set $header (i32.const 0))
        (global.set $text_len (i32.const 0))
        (call $parse_object (i32.const 0))
        (call $run_case)
        (call $skip_ws)
        (if (i32.eq (i32.load8_u (global.get $in_pos)) (i32.const 44))
          (then
            (global.set $in_pos (i32.add (global.get $in_pos) (i32.const 1)))
            (br $cases))
          (else (br $all)))))
    (global.set $wp (global.get $out_end))
    (call $w8 (i32.const 93))
    (global.set $out_end (global.get $wp))
    (i32.sub (global.get $out_end) (global.get $OUT_BASE)))
)
